# Copy this file to ".env" and fill in the values.
# Nothing here is uploaded anywhere except api.anthropic.com.

# Required for Jane to think. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
JANE_MODEL=claude-opus-5
JANE_EFFORT=medium
JANE_PORT=8765

# Where Jane thinks she is. Used for weather, headlines and the clock.
JANE_CITY=Pune
JANE_COUNTRY=IN

# Set to 1 to let Jane launch whitelisted desktop apps and open URLs.
JANE_ALLOW_LAUNCH=1

# --- Email (compose → read back → send, only on your confirmation) ---------
# Off by default. Turn on and give Jane an outbox to send from. With Gmail you
# must use an App Password (not your normal password): https://myaccount.google.com/apppasswords
JANE_ALLOW_EMAIL=0
JANE_SMTP_HOST=smtp.gmail.com
JANE_SMTP_PORT=587
JANE_SMTP_USER=you@gmail.com
JANE_SMTP_PASS=your-16-char-app-password
# Optional; defaults to JANE_SMTP_USER.
JANE_EMAIL_FROM=you@gmail.com

# --- Desktop control (installed apps, WhatsApp, games) ---------------------
# Opens the *installed* WhatsApp/Steam/etc. via their launch protocols.
JANE_ALLOW_DESKTOP=1
# After you confirm a WhatsApp message, press Enter for you (synthesised
# keystroke to the focused window). Set 0 to pre-fill only and press Enter yourself.
JANE_WHATSAPP_AUTOSEND=1
# Optional alias files (JSON, {"name": "target"}): data/contacts.json (name → phone),
# data/games.json (name → steam://... or app id), data/apps.json (name → command).

# --- Voice ------------------------------------------------------------------
# auto = natural neural voice if edge-tts is installed, else the browser voice.
#        (pip install edge-tts).   edge = require it.   browser = always browser.
#        eleven = ElevenLabs cloud voices (fill in the two lines below).
JANE_TTS=auto
JANE_TTS_VOICE=en-GB-RyanNeural
JANE_TTS_RATE=-4%
JANE_TTS_PITCH=-2Hz

# ElevenLabs (only used when JANE_TTS=eleven). Key: https://elevenlabs.io → Profile.
# Voice id: pick a voice in the ElevenLabs VoiceLab/Voices page and copy its ID.
ELEVENLABS_API_KEY=
JANE_ELEVEN_VOICE=
JANE_ELEVEN_MODEL=eleven_turbo_v2_5
